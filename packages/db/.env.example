# Copy this file to .env and fill in real values. .env is never committed.

# Superuser connection to the local Postgres, used by database tests to create the test database
# and roles. CI sets this variable itself (see .github/workflows/ci.yml).
DATABASE_TEST_ADMIN_URL=postgres://lytronix:lytronix_local_only@localhost:5433/postgres

# Connection used by the migration command (npm run migrate). Runs as the schema owner.
DATABASE_URL=postgres://lytronix:lytronix_local_only@localhost:5433/lytronix
