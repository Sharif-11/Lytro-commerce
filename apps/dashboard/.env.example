# Where the Vite dev server forwards /api/* (docs/DEPLOYMENT.md §5 mirrored locally). Production needs no
# value: Caddy proxies /api on app.lytro.app and the app calls same-origin /api/v1/....
VITE_API_PROXY_TARGET=http://localhost:3000

# The platform domain shown next to a shop's link (`<slug>.lytro.app`) and in the dashboard address preview.
VITE_PLATFORM_DOMAIN=lytro.app

# The marketing site, for the Terms and Privacy links under the entry screen's buttons (LEG-01).
VITE_SITE_URL=https://lytro.app

# The support WhatsApp the Menu's Help row opens (8801XXXXXXXXX, the website's SUPPORT_WHATSAPP); without one the
# row is not shown. The browser tests expect 8801000000000, as CI builds with.
# VITE_SUPPORT_WHATSAPP=8801XXXXXXXXX
