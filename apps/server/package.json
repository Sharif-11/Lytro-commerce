{
  "name": "@lytronix/server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API and jobs (modular monolith). See docs/ENGINEERING-STANDARDS.md §1.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "pnpm --filter @lytronix/db migrate",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@lytronix/db": "workspace:^",
    "@lytronix/shared-types": "workspace:^",
    "@lytronix/validators": "workspace:^",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^8.1.1",
    "@scalar/nestjs-api-reference": "^1.2.29",
    "@sentry/node": "11.10.0",
    "@tygra/nestjs-graceful-shutdown": "^2.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cron-parser": "^5.10.1",
    "dotenv": "^16",
    "ffmpeg-static": "5.3.0",
    "ioredis": "^5",
    "lru-cache": "11.5.3",
    "nestjs-zod": "^5.5.0",
    "otplib": "^13",
    "pg-boss": "^12",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nestjs/testing": "^10",
    "@playwright/test": "1.64.0",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/web-push": "^3.6.4",
    "pg": "^8",
    "tsx": "^4",
    "vitest": "^2.1.2"
  }
}
