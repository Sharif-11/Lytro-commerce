{
  "name": "@lytronix/server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API and jobs (modular monolith). See docs/ENGINEERING-STANDARDS.md §1.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "pnpm --filter @lytronix/db migrate",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@lytronix/db": "workspace:^",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "vitest": "^2.1.2"
  }
}
