{
  "name": "@lytronix/server",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API and jobs (modular monolith). See docs/ENGINEERING-STANDARDS.md §1.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "drizzle-orm": "^0.36",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8",
    "drizzle-kit": "^0.28",
    "vitest": "^2.1.2"
  }
}
