# Copy this file to .env and fill in real values. .env is never committed.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port and the interface to listen on (0.0.0.0 makes the server reachable on the LAN).
PORT=3000
HOST=0.0.0.0

# Platform domain: shops are served at <slug>.<PLATFORM_DOMAIN>. Development uses localhost (D4).
PLATFORM_DOMAIN=localhost

# Shared secret Cloudflare adds to forwarded requests. Required in production (at least 32
# characters); leave unset in development. Never commit a real value.
# TRUSTED_EDGE_SECRET=

# The request header that carries the client's address from the edge. Cloudflare sends cf-connecting-ip (the
# default); a proxy that sends X-Forwarded-For is set as x-forwarded-for. Read only with the edge secret.
# CLIENT_IP_HEADER=cf-connecting-ip

# Secret for hashing one-time sign-up codes (at least 32 characters). Never commit a real value.
OTP_SECRET=change_me_local_only_at_least_32_chars_long

# Application database connection. Local value matches the Docker Postgres in the repository root.
# Connection pool: connections per server (default 5), milliseconds to wait for a connection (default
# 5000), and milliseconds one statement may run (default 10000).
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_URL=postgres://lytronix_app:lytronix_app_local_only@localhost:5433/lytronix
