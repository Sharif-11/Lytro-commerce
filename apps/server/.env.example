# Copy this file to .env and fill in real values. .env is never committed.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port and the interface to listen on (0.0.0.0 makes the server reachable on the LAN).
PORT=3000
HOST=0.0.0.0

# Platform domain: shops are served at <slug>.<PLATFORM_DOMAIN>. Development uses localhost (D4).
PLATFORM_DOMAIN=localhost

# Shared secret Cloudflare adds to forwarded requests. Required in production (at least 32
# characters); leave unset in development. Never commit a real value.
# TRUSTED_EDGE_SECRET=

# The header that carries the client address from the edge, read only with the edge secret. For a list
# (X-Forwarded-For) the entry TRUSTED_PROXY_HOPS places from the end is used; for a single value, set CLIENT_IP_FORMAT=single.
# CLIENT_IP_HEADER=x-forwarded-for
# CLIENT_IP_FORMAT=list
# TRUSTED_PROXY_HOPS=1

# A second edge secret, set only while the edge secret is being rotated. Remove it once the edge uses the new one.
# TRUSTED_EDGE_SECRET_NEXT=

# Secret for hashing one-time sign-up codes (at least 32 characters). Never commit a real value.
OTP_SECRET=change_me_local_only_at_least_32_chars_long

# Google/Facebook sign-in (AUTH-24). Each provider is enabled only when its *_ENABLED flag is true and its
# ID/secret are set — leave a provider's vars unset to disable it (apps/admin's sign-in screen only shows a
# button for providers GET auth/providers reports as enabled).
# GOOGLE_SIGN_IN_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_SIGN_IN_ENABLED=true
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Where the OAuth provider redirects back to, before this path is appended: /auth/oauth/:provider/callback.
# Must point at apps/admin's own origin (its dev port, or the tenant-facing host in production), not the
# backend directly — the SPA route there makes the actual backend call itself (docs/DEPLOYMENT.md §5). This
# exact value must also be a registered redirect URI in each provider's developer console.
OAUTH_CALLBACK_BASE=http://localhost:3002

# Application database connection. Local value matches the Docker Postgres in the repository root.
# Connection pool: connections per server (default 5), milliseconds to wait for a connection (default
# 5000), and milliseconds one statement may run (default 10000).
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_URL=postgres://lytronix_app:lytronix_app_local_only@localhost:5433/lytronix
