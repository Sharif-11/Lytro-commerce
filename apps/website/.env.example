# Where this site reaches the backend, server-side only (docs/DEPLOYMENT.md §5: lytro.app forwards no /api).
# In production this is the server container inside the deployment; locally, the server's own dev port.
SERVER_URL=http://localhost:3000

# The backend refuses every request that does not carry the trusted-edge secret (§6). The same value Caddy
# adds on proxied requests. Leave unset only against a local server started without one.
# TRUSTED_EDGE_SECRET=

# The dashboard host: every sign-up, sign-in and "open a free shop" link points here (TEN-31).
APP_URL=https://app.lytro.app

# This site's own public address, used for canonical and link-preview metadata.
SITE_URL=https://lytro.app

# Comma-separated list of features that are live and may be shown on the landing page (the "only claim what
# is live" rule, docs/LANDING-PAGE-DESIGN.md §7): inventory, statistics, showcase.
# LIVE_FEATURES=

# Where the contact form posts (a webhook that creates a ticket or sends an email). Unset: the form tells the
# visitor to use WhatsApp instead of pretending to send.
# CONTACT_WEBHOOK_URL=

# Support contact shown on the contact page and in the footer. Unset values are simply not shown.
# SUPPORT_WHATSAPP=8801XXXXXXXXX
# SUPPORT_PHONE=+880 1X-XXXX-XXXX
# SUPPORT_EMAIL=hello@lytro.app
