# Where the storefront reaches the server, server-side only (docs/DEPLOYMENT.md §8): in production the server container
# inside the deployment; locally, the server's own dev port. The public API is called here with Host: api.<domain>.
SERVER_URL=http://localhost:3000

# The platform's domain, as the server's: shops are <slug>.<PLATFORM_DOMAIN>, the public API answers on api.<domain>.
PLATFORM_DOMAIN=localhost

# The edge's secret (§6), so the server trusts the shopper's address passed on. Leave unset only against a local server
# started without one. Never commit a real value.
# TRUSTED_EDGE_SECRET=

# The header the edge puts the shopper's address in, as the server's CLIENT_IP_HEADER. Passed on as it arrives.
# CLIENT_IP_HEADER=x-forwarded-for

# The server's STOREFRONT_SECRET: lets this app read each shop's storefront key. Never on the edge, never committed.
# STOREFRONT_SECRET=

# Read at build time (Slice 12c): the service worker's version, so each build's worker drops the last one's files. The
# deployment's commit; left unset, the build's time.
# STOREFRONT_BUILD_ID=
