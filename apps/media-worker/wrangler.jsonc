{
  "$schema": "node_modules/wrangler/config-schema.json",
  // MED-02, BND-01: the media address, in front of the media bucket. Every request for a shop's media is metered here.
  "name": "lytro-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  // MED-02: the Worker answers the media address itself; no cache rule sits in front of it.
  "routes": [{ "pattern": "media.lytro.app", "custom_domain": true }],
  // MED-10, MED-13: the shared store the server writes (namespace `lytro-media-edge`). The server's
  // MEDIA_EDGE_KV_NAMESPACE_ID is this same id. `wrangler dev` uses a local copy unless run with --remote.
  "kv_namespaces": [{ "binding": "MEDIA_EDGE", "id": "04fe2245979a4ecb8c25f01a0dd03b1f" }],
  // BND-01: one data point per response, totalled by the server each minute.
  "analytics_engine_datasets": [{ "binding": "MEDIA_USAGE", "dataset": "lytro_media_usage" }],
  "vars": {
    "R2_BUCKET": "lytro-media",
    "DASHBOARD_ORIGINS": "https://app.lytro.app,https://admin.lytro.app",
  },
  // Secrets, set with `wrangler secret put` (or `.dev.vars` for `wrangler dev`), never written here (MED-07):
  // R2_ENDPOINT, R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY (an Object Read only token), and MEDIA_LINK_SECRET.
  "observability": { "enabled": true },
  // Staging (Phase 9 Slice 9.1): `wrangler deploy --env staging` makes the Worker `lytro-media-staging` at its own
  // address, over staging's own media bucket, store and dataset, so nothing staging does reaches production's. One
  // level under lytro.app, so Cloudflare's own certificate covers it. Its secrets are put with `--env staging`.
  "env": {
    "staging": {
      "routes": [{ "pattern": "media-staging.lytro.app", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "MEDIA_EDGE", "id": "5acdeb372d814be0b8a2b551ed6ab357" }],
      "analytics_engine_datasets": [
        { "binding": "MEDIA_USAGE", "dataset": "lytro_staging_media_usage" },
      ],
      "vars": {
        "R2_BUCKET": "lytro-staging-media",
        "DASHBOARD_ORIGINS": "https://app.staging.lytro.app,https://admin.staging.lytro.app",
      },
    },
  },
}
