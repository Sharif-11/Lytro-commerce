{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "TRUSTED_EDGE_SECRET",
        "SERVER_URL",
        "APP_URL",
        "SITE_URL",
        "LIVE_FEATURES",
        "CONTACT_WEBHOOK_URL",
        "SUPPORT_EMAIL",
        "NEXT_STANDALONE",
        "STOREFRONT_BUILD_ID"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_TEST_ADMIN_URL"],
      "passThroughEnv": ["CI", "CADDY_IMAGE"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "env": ["DATABASE_TEST_ADMIN_URL"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "HOST",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_CONNECT_TIMEOUT_MS",
        "DATABASE_STATEMENT_TIMEOUT_MS",
        "PLATFORM_DOMAIN",
        "TRUSTED_EDGE_SECRET",
        "OTP_SECRET",
        "SERVER_URL",
        "APP_URL",
        "SITE_URL",
        "LIVE_FEATURES",
        "CONTACT_WEBHOOK_URL",
        "SUPPORT_EMAIL"
      ]
    }
  }
}
