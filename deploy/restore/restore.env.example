# The settings a restore drill needs away from the server (Phase 9 Slice 9.3; RUNBOOKS.md "Backups and restores"): on
# the owner's computer or a fresh server. Copy it OUTSIDE every repository (e.g. restore.env beside the owner's keys),
# fill it from the owner's offline copies, and never commit or paste it anywhere.

BACKUP_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com

# The read-only restore token (lytro-staging-backups-restore): it reads both buckets and can change nothing.
BACKUP_PITR_BUCKET=lytro-staging-pitr
BACKUP_PITR_KEY_ID=
BACKUP_PITR_KEY_SECRET=
BACKUP_DUMP_BUCKET=lytro-staging-dumps
BACKUP_DUMP_KEY_ID=
BACKUP_DUMP_KEY_SECRET=

# The archive's encryption key, from the owner's offline copy (the server's backup.env has the same).
BACKUP_PITR_ENCRYPTION_KEY=

# The database's owner, as on the servers.
POSTGRES_USER=lytronix
RESTORE_DB_NAME=lytronix
