#!/usr/bin/env bash
# The base backup for restoring to a minute (Phase 9 Slice 9.3, DAT-34, BKP-01, D9-18), run by the backup service
# (lytro-nightly) right after the dump. With the archived write-ahead log, any minute since the oldest kept base backup
# can be restored.
#
#   - a full backup on BACKUP_FULL_WEEKDAY in Dhaka (1 = Monday ... 5 = Friday, the default), or when none exists yet;
#     on other days only what changed since that week's full one (a differential: WALG_DELTA_ORIGIN=LATEST_FULL)
#   - then the oldest are deleted, keeping BACKUP_KEEP_FULL full backups (3: between 14 and 21 days, DAT-34's 14 at
#     least). The bucket's 14-day lock has always lapsed on what this deletes; if it hasn't, the delete is refused,
#     nothing is lost, and the next night tries again.
#
# It reads the database's files from the data folder (mounted read-only into the backup service) and asks PostgreSQL
# to start and stop the backup over the network.
set -euo pipefail
. lytro-pg-env

say() { printf '[base %s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }

mkdir -p "$BACKUP_WORK_DIR/status"
weekday="$(date -u -d '+6 hours' +%u)"
existing="$(lytro-walg backup-list --json 2> /dev/null | jq 'length' 2> /dev/null || echo 0)"
full=()
if [ "$weekday" = "${BACKUP_FULL_WEEKDAY:-5}" ] || [ "${existing:-0}" = 0 ]; then
  full=(--full)
  say "full backup (Dhaka weekday $weekday, $existing kept)"
else
  say "differential backup since the week's full one ($existing kept)"
fi

lytro-walg backup-push "${full[@]}" "$PGDATA"

newest="$(lytro-walg backup-list --json --detail | jq -r 'max_by(.finish_time) | "\(.backup_name)\t\(.finish_time)"')"
say "made ${newest%%$'\t'*}"

keep="${BACKUP_KEEP_FULL:-3}"
if lytro-walg delete retain FULL "$keep" --confirm; then
  say "kept the newest $keep full backups and what they need"
else
  say "old backups not deleted this time (still locked, or the delete failed); nothing is lost, it retries tomorrow"
fi

jq -n --arg name "${newest%%$'\t'*}" --arg finished "${newest#*$'\t'}" --arg kind "${full[0]:-delta}" \
  --argjson at "$(date -u +%s)" '{ name: $name, finish_time: $finished, kind: $kind, finished_at_epoch: $at }' \
  > "$BACKUP_WORK_DIR/status/base.json"
