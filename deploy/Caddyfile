# The edge config for docs/DEPLOYMENT.md's routing rules (§5). Implements that document; doesn't restate its reasoning —
# read DEPLOYMENT.md first if a rule here looks surprising, it probably explains why.
#
# It runs in the edge image (deploy/caddy/Dockerfile: Caddy with the Cloudflare DNS plugin), which checks this file with
# `caddy validate` when it is built, under deploy/compose.yml's container names (Slice 9.1, D9-10). Every host is named
# from PLATFORM_DOMAIN, the server's own setting (R1, R2), so one deployment file names the domain for both; lytro.app when
# it isn't set, staging.lytro.app on staging (D9-9). apps/server/test/caddy-edge.e2e.spec.ts runs this file in that image
# in front of the server under PLATFORM_DOMAIN=localhost, and sends each kind of outside call through it.
#
# SERVER_UPSTREAM may name several API processes, space-separated ("api-1:3000 api-2:3000", D9-11): Caddy spreads requests
# over them, checks each one's /health, and retries a request on another while one is being replaced, so a deploy that
# replaces them one at a time loses nothing (D9-12). The worker process is never named here.
{
	email {$ACME_EMAIL}

	# TEN-13 (Slice 13): a shop's own domain gets its certificate the first time it is asked for (On-Demand TLS), and
	# only once the backend says a shop serves that name now -- its active domain or that domain's twin. Caddy adds
	# `?domain=<name>`; any answer but 2xx refuses, so no certificate is spent on a name nobody verified. Asked through
	# the internal listener below, so any healthy API process answers.
	on_demand_tls {
		ask http://localhost:8080/api/v1/internal/domains/ask
	}
}

# --- Shared pieces (DEPLOYMENT.md §5, §6) ---

# How Caddy reaches the API processes: round robin, each one's /health checked every few seconds, and a request whose
# process is down (being replaced, D9-12) tried again on another for up to 10 seconds.
(server_balancing) {
	lb_policy round_robin
	lb_try_duration 10s
	lb_try_interval 250ms
	fail_duration 10s
	# Slice 9.2 (D9-21): the ready check, so a process whose write pool reaches a standby, or nothing at all, is skipped.
	health_uri /health/ready
	health_interval 5s
	health_timeout 3s
}

# The API with the edge secret attached (§6), for the hosts whose browsers and outside services reach it through Caddy.
(server_proxy) {
	reverse_proxy {$SERVER_UPSTREAM:server:3000} {
		header_up x-lytronix-edge-secret {$TRUSTED_EDGE_SECRET}
		import server_balancing
	}
}

# /api/* -> reverse-proxy to the backend unchanged, with the edge secret attached (§6). Only the two app
# hosts import this: the marketing site and the storefront call the backend server-side instead (§5), so a
# browser on lytro.app or a shop's subdomain never reaches /api at all. No path rewrite (API-14): the backend
# itself serves everything under /api/v1, the exact prefix the SPA calls, so `handle` (not `handle_path`)
# passes the request through with nothing stripped.
(api_proxy) {
	handle /api/* {
		import server_proxy
	}
}

# The wildcard certificate for every shop's subdomain (`*.lytro.app`) needs the DNS-01 challenge, through Cloudflare's
# API with a token that can only edit this domain's DNS records (D9-10; never the server's media token,
# CLOUDFLARE_API_TOKEN). Set on the wildcard site alone: a global `acme_dns` would apply to shops' own domains too, whose
# DNS isn't ours (TEN-13). WILDCARD_TLS names the snippet; the Caddy test uses `wildcard_tls_auto`, Caddy's own local
# certificate for *.localhost.
(wildcard_tls_dns) {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

(wildcard_tls_auto) {
	# Caddy's default for the name.
}

# Whether search engines may index these hosts. Staging sets ROBOTS=robots_noindex, so nothing on staging.lytro.app is
# indexed beside lytro.app (D9-9).
(robots_allow) {
	# Indexing is each app's own business (the website's robots.txt).
}

(robots_noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# A static SPA build: no process, Caddy serves dist/ directly (§8), falling back to index.html for any
# unmatched path so the client-side router takes over. Inside its own `handle`, so it only ever sees what /api/*
# did not take: Caddy runs `try_files` (a rewrite) before any `handle`, so at the top level it rewrote every API
# call to index.html first (KNOWN-GAPS §90). `handle` blocks are tried most specific first, one only.
(dashboard_spa) {
	handle {
		root * {$DASHBOARD_DIST_PATH:/srv/dashboard/dist}
		try_files {path} /index.html
		file_server
	}
}

(operator_spa) {
	handle {
		root * {$OPERATOR_DIST_PATH:/srv/operator/dist}
		try_files {path} /index.html
		file_server
	}
}

# The operator console's own strict Content Security Policy (DEPLOYMENT.md §5, D3-12): every script, style,
# fetch, worker and manifest from the console's own origin only. The two exceptions are fonts (Google Fonts'
# stylesheet and its font files), data: images (the two-factor QR code, drawn client-side, ADM-01), and
# MEDIA_STORAGE_ENDPOINT for payment screenshots (ADM-14, ADM-17, Slice 8.8): a manual entry's upload goes
# straight to its signed link, and a screenshot shows from its five-minute link. No inline script, no plugin,
# no framing and no <base>: an injected script has nowhere to load from and nothing to send to.
(operator_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: {$MEDIA_STORAGE_ENDPOINT}; connect-src 'self' {$MEDIA_STORAGE_ENDPOINT}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
}

# The tenant dashboard's own Content Security Policy (KNOWN-GAPS §65, Slice 11.13a), on the console's model:
# scripts, styles, fetches, the service worker and the shop's manifest from the dashboard's own origin. Beyond it:
# - a shop's images and video from MEDIA_PUBLIC_BASE_URL, the media Worker's address (an origin, no path);
# - uploads straight to MEDIA_STORAGE_ENDPOINT, addressed path-style (MEDIA_STORAGE_PATH_STYLE, true for R2);
# - Google Fonts' stylesheet and font files, for a shop's brand fonts (Slice 11.2, BRN-02);
# - blob: video, which only the barcode reader's fallback for old browsers uses.
# Both addresses are the server's own settings, so one deployment file feeds the server and Caddy. No inline
# script or style: a shop's theme sets its colours through the CSSOM, never a <style> element. No plugin, no
# framing, no <base>. The Permissions-Policy keeps the camera for the dashboard's own IMEI scanning and turns
# off what it never uses. apps/dashboard/e2e/csp.spec.ts reads this block and walks every screen under it.
(dashboard_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' {$MEDIA_PUBLIC_BASE_URL}; media-src 'self' blob: {$MEDIA_PUBLIC_BASE_URL}; connect-src 'self' {$MEDIA_STORAGE_ENDPOINT}; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
}

# lytro.app: the marketing site only (apps/website). www redirects to the apex.
www.{$PLATFORM_DOMAIN:lytro.app} {
	import {$ROBOTS:robots_allow}
	redir https://{$PLATFORM_DOMAIN:lytro.app}{uri} permanent
}

# One website process: while it restarts in a deploy, a request waits for it (up to 10 seconds) instead of failing.
{$PLATFORM_DOMAIN:lytro.app} {
	import {$ROBOTS:robots_allow}
	reverse_proxy {$WEBSITE_UPSTREAM:website:3003} {
		lb_try_duration 10s
	}
}

# app.lytro.app: sign-up, sign-in, create-shop, the OAuth callback and every shop's dashboard at /<slug>
# (apps/dashboard, TEN-31), under its own Content Security Policy. The session cookie is host-only here (TEN-29).
app.{$PLATFORM_DOMAIN:lytro.app} {
	import dashboard_csp
	import {$ROBOTS:robots_allow}
	import api_proxy
	import dashboard_spa
}

# admin.lytro.app: the operator console (apps/operator, its own build, D3-12), under its own strict Content
# Security Policy. The operator session cookie is host-only here (TEN-29).
admin.{$PLATFORM_DOMAIN:lytro.app} {
	import operator_csp
	import {$ROBOTS:robots_allow}
	import api_proxy
	import operator_spa
}

# pay.lytro.app: the payment page, drawn by the backend, which sets the page's Content Security Policy itself (PAY-23,
# Slice 5.8's part 2). The backend's PaymentPageHost turns every address on this host into one of the page's own routes,
# so nothing else on the server can be reached from here. No wildcard below takes it: an exact host wins.
pay.{$PLATFORM_DOMAIN:lytro.app} {
	import {$ROBOTS:robots_allow}
	import server_proxy
}

# api.lytro.app: what other services call, at /v1/... (API-14): the public API with a key, a wallet's return, the listener
# app, and couriers' and Resend's messages. Forwarded as it came, with the edge secret. The server maps /v1/... to its
# public routes itself (PublicApiHost) and refuses every other route on this host (TenantGuard), so what answers here is
# decided in one place. No rewrite and no path rules here: the server doesn't serve /api/v1/... on this host (KNOWN-GAPS
# §141).
api.{$PLATFORM_DOMAIN:lytro.app} {
	import {$ROBOTS:robots_allow}
	import server_proxy
}

# *.lytro.app (any other single-label host — a shop's own subdomain): the storefront and landing pages only
# (apps/storefront). No dashboard and no /api on a shop host (§5). Covers every tenant automatically; `app`,
# `admin`, `api`, `pay` and `www` are reserved labels (TEN-26), so no shop can take them.
*.{$PLATFORM_DOMAIN:lytro.app} {
	import {$WILDCARD_TLS:wildcard_tls_dns}
	import {$ROBOTS:robots_allow}
	# storefront reads Host itself to resolve which tenant to render (SFT-01) — Caddy passes Host through
	# unmodified by default, no explicit header handling needed here.
	reverse_proxy {$STOREFRONT_UPSTREAM:storefront:3001} {
		lb_try_duration 10s
	}
}

# --- Custom domains (TEN-09, TEN-11, TEN-13, TEN-24, Slice 13) ---
#
# Any other host is a shop's own domain (DEPLOYMENT.md §7): served by the storefront exactly as a shop's subdomain is,
# the storefront resolving the shop from Host through the backend's verified domains (HostClassifier's 'custom'
# branch, a database lookup, never a config change here). Its certificate comes on demand, gated by the ask above. A
# domain that is not active answers the storefront's own not-found (TEN-25); the storefront leads a domain's twin and
# the shop's subdomain to the active domain with a 308 (Slice 13's read, points 2 and 3).
https:// {
	tls {
		on_demand
	}
	import {$ROBOTS:robots_allow}
	reverse_proxy {$STOREFRONT_UPSTREAM:storefront:3001} {
		lb_try_duration 10s
	}
}

# --- Inside the deployment only (D9-12) ---
#
# The website and the storefront call the API from their own servers (§5), and the certificate check above asks it too.
# They come here, never published outside the deployment's network, so the API processes are balanced and health-checked
# for them as for browsers. The storefront sends the shopper's address with its own edge secret (SFT-11); Caddy keeps
# that address exactly as sent, or the server would take the storefront's own address for the shopper's.
http://:8080 {
	@forwarded header_regexp X-Forwarded-For .+
	handle @forwarded {
		reverse_proxy {$SERVER_UPSTREAM:server:3000} {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			import server_balancing
		}
	}
	handle {
		reverse_proxy {$SERVER_UPSTREAM:server:3000} {
			import server_balancing
		}
	}
}
