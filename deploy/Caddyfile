# Production edge config for docs/DEPLOYMENT.md's routing rules (§5). Implements that document; doesn't
# restate its reasoning — read DEPLOYMENT.md first if a rule here looks surprising, it probably explains why.
#
# Status: not yet deployed anywhere (DEPLOYMENT.md's own status line: "planned, not yet built — no server
# exists to point DNS at"). Written and validated (`caddy validate`) against that plan so the actual VPS
# setup is "point DNS here and run this," not a rewrite.
#
# Service names below (server, website, storefront) match DEPLOYMENT.md §2's topology diagram — a production
# docker-compose (or equivalent) is expected to name its containers the same way; override via the {$...}
# environment placeholders if it doesn't.
{
	# DEPLOYMENT.md §3: Caddy's built-in ACME client needs the DNS-01 challenge for *.lytro.app's wildcard
	# cert, which needs a DNS-provider plugin (built in via xcaddy) and that provider's own directive here —
	# neither the VPS provider nor the DNS registrar is chosen yet (§10's own "open, deliberately deferred"
	# list). Fill in once both are: for example, for Cloudflare DNS,
	#   acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
	# and rebuild this Caddy image with that plugin (xcaddy build --with github.com/caddy-dns/cloudflare).
	email {$ACME_EMAIL}

	# TEN-13 (Slice 13): a shop's own domain gets its certificate the first time it is asked for (On-Demand TLS), and
	# only once the backend says a shop serves that name now -- its active domain or that domain's twin. Caddy adds
	# `?domain=<name>`; any answer but 2xx refuses, so no certificate is spent on a name nobody verified.
	on_demand_tls {
		ask http://{$SERVER_UPSTREAM:server:3000}/api/v1/internal/domains/ask
	}
}

# --- Shared pieces (DEPLOYMENT.md §5, §6) ---

# /api/* -> reverse-proxy to the backend unchanged, with the edge secret attached (§6). Only the two app
# hosts import this: the marketing site and the storefront call the backend server-side instead (§5), so a
# browser on lytro.app or a shop's subdomain never reaches /api at all. No path rewrite (API-14): the backend
# itself serves everything under /api/v1, the exact prefix the SPA calls, so `handle` (not `handle_path`)
# passes the request through with nothing stripped.
(api_proxy) {
	handle /api/* {
		reverse_proxy {$SERVER_UPSTREAM:server:3000} {
			header_up x-lytronix-edge-secret {$TRUSTED_EDGE_SECRET}
		}
	}
}

# A static SPA build: no process, Caddy serves dist/ directly (§8), falling back to index.html for any
# unmatched path so the client-side router takes over. Inside its own `handle`, so it only ever sees what /api/*
# did not take: Caddy runs `try_files` (a rewrite) before any `handle`, so at the top level it rewrote every API
# call to index.html first (KNOWN-GAPS §90). `handle` blocks are tried most specific first, one only.
(dashboard_spa) {
	handle {
		root * {$DASHBOARD_DIST_PATH:/srv/dashboard/dist}
		try_files {path} /index.html
		file_server
	}
}

(operator_spa) {
	handle {
		root * {$OPERATOR_DIST_PATH:/srv/operator/dist}
		try_files {path} /index.html
		file_server
	}
}

# The operator console's own strict Content Security Policy (DEPLOYMENT.md §5, D3-12): every script, style,
# fetch, worker and manifest from the console's own origin only. The two exceptions are fonts (Google Fonts'
# stylesheet and its font files) and data: images (the two-factor QR code, drawn client-side, ADM-01). No
# inline script, no plugin, no framing and no <base>: an injected script has nowhere to load from and
# nothing to send to.
(operator_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
}

# The tenant dashboard's own Content Security Policy (KNOWN-GAPS §65, Slice 11.13a), on the console's model:
# scripts, styles, fetches, the service worker and the shop's manifest from the dashboard's own origin. Beyond it:
# - a shop's images and video from MEDIA_PUBLIC_BASE_URL, the media Worker's address (an origin, no path);
# - uploads straight to MEDIA_STORAGE_ENDPOINT, addressed path-style (MEDIA_STORAGE_PATH_STYLE, true for R2);
# - Google Fonts' stylesheet and font files, for a shop's brand fonts (Slice 11.2, BRN-02);
# - blob: video, which only the barcode reader's fallback for old browsers uses.
# Both addresses are the server's own settings, so one deployment file feeds the server and Caddy. No inline
# script or style: a shop's theme sets its colours through the CSSOM, never a <style> element. No plugin, no
# framing, no <base>. The Permissions-Policy keeps the camera for the dashboard's own IMEI scanning and turns
# off what it never uses. apps/dashboard/e2e/csp.spec.ts reads this block and walks every screen under it.
(dashboard_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' {$MEDIA_PUBLIC_BASE_URL}; media-src 'self' blob: {$MEDIA_PUBLIC_BASE_URL}; connect-src 'self' {$MEDIA_STORAGE_ENDPOINT}; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
}

# lytro.app: the marketing site only (apps/website). www redirects to the apex.
www.lytro.app {
	redir https://lytro.app{uri} permanent
}

lytro.app {
	reverse_proxy {$WEBSITE_UPSTREAM:website:3003}
}

# app.lytro.app: sign-up, sign-in, create-shop, the OAuth callback and every shop's dashboard at /<slug>
# (apps/dashboard, TEN-31), under its own Content Security Policy. The session cookie is host-only here (TEN-29).
app.lytro.app {
	import dashboard_csp
	import api_proxy
	import dashboard_spa
}

# admin.lytro.app: the operator console (apps/operator, its own build, D3-12), under its own strict Content
# Security Policy. The operator session cookie is host-only here (TEN-29).
admin.lytro.app {
	import operator_csp
	import api_proxy
	import operator_spa
}

# api.lytro.app: the public API, keys only (API-14). /v1/* is proxied as /api/v1/* with the edge secret.
api.lytro.app {
	handle_path /v1/* {
		rewrite * /api/v1{uri}
		reverse_proxy {$SERVER_UPSTREAM:server:3000} {
			header_up x-lytronix-edge-secret {$TRUSTED_EDGE_SECRET}
		}
	}
	respond 404
}

# *.lytro.app (any other single-label host — a shop's own subdomain): the storefront and landing pages only
# (apps/storefront). No dashboard and no /api on a shop host (§5). Covers every tenant automatically; `app`,
# `admin`, `api`, `pay` and `www` are reserved labels (TEN-26), so no shop can take them.
*.lytro.app {
	# storefront reads Host itself to resolve which tenant to render (SFT-01) — Caddy passes Host through
	# unmodified by default, no explicit header handling needed here.
	reverse_proxy {$STOREFRONT_UPSTREAM:storefront:3001}
}

# --- Custom domains (TEN-09, TEN-11, TEN-13, TEN-24, Slice 13) ---
#
# Any other host is a shop's own domain (DEPLOYMENT.md §7): served by the storefront exactly as a shop's subdomain is,
# the storefront resolving the shop from Host through the backend's verified domains (HostClassifier's 'custom'
# branch, a database lookup, never a config change here). Its certificate comes on demand, gated by the ask above. A
# domain that is not active answers the storefront's own not-found (TEN-25); the storefront leads a domain's twin and
# the shop's subdomain to the active domain with a 308 (Slice 13's read, points 2 and 3).
https:// {
	tls {
		on_demand
	}
	reverse_proxy {$STOREFRONT_UPSTREAM:storefront:3001}
}
